<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Events</title>
</head>
<body>
<div>
    <form action="addEvent" method="post">
        User Name  : <input type="text" name="uName"><br>
        <br>
        Date of Birth : <input type="text" name="dob"><br>
        <br>
        Email Id : <input type="text" name="email"><br>
